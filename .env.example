# GEMINI_API_KEY: Required for Gemini AI API calls (if applicable)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Server Port (default 3000)
PORT="3000"

# SMTP Check Toggle (Set to 'true' only if hosting provider permits outbound TCP port 25)
# Recommended default is 'false' on cloud hosts (Render, Cloud Run, AWS, etc.)
ENABLE_SMTP_CHECK="false"

# Maximum email batch size per request
MAX_BATCH_SIZE="100"

# DNS timeout in seconds
DNS_TIMEOUT_SECONDS="3.0"

# SMTP probe timeout in seconds
SMTP_TIMEOUT_SECONDS="3.0"

# SMTP HELO identification domain
SMTP_HELO_DOMAIN="mailcheck.local"

# SMTP MAIL FROM address for safe RCPT probes
SMTP_FROM_EMAIL="verify@mailcheck.local"
